# 凭据（任何情况下不入库）
.env
**/.env

# Python 缓存 / 虚拟环境 / 工具缓存
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 本地运行数据库与作业日志（运行时生成、可重建，不是实验证据）
outputs/agent_jobs/
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# 每次运行新生成的 smoke run 目录：可重建的流水线产物，不是固化证据。
# 已入库的历史 run 不受影响（gitignore 不会取消对已追踪文件的跟踪）。
outputs/pendulum_smoke/*/

# P1-04 Campaign 生成的候选配置与清单：每次运行可重建，且 campaign_id 唯一。
# 真正的 checkpoint / worker 日志仍留在 outputs/<experiment>/<run_id>/，不复制。
outputs/research_campaigns/

# 刻意不忽略：
#   outputs/ 下已入库的历史实验记录（checkpoint / 指标 / 图 / 公式）属于研究证据；
#   datasets/ 下的冻结数据集与 manifest.json 属于可复现性证据。
# 二者是否入库由提交者按实验决定，忽略规则不替其做决定。

# P2-01 生成的 Pusher 轨迹数据：每次可由 scripts/collect_pusher.py 重新生成
# （dataset_seed 固定 → 内容寻址 dataset_version 固定），因此默认不入库，
# 避免仓库膨胀。若要固化某次数据集作为证据，按上面说明显式 `git add`。
datasets/pusher_v1/
